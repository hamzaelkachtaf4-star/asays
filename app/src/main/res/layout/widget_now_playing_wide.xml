<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget 4x2 facon Spotify : fond degrade (couleur de la pochette), pochette +
  titre/artiste + 3 controles sur la premiere ligne, puis une ligne de 5 tuiles
  (file d'attente en cours) qui ouvrent l'app d'un seul tap.
  Les pochettes des tuiles sont posees par PlayerWidgetUpdater.

  Meme systeme que le 4x1 : titre 14sp gras, artiste 12sp (80% blanc), pochette
  (logo centre tant qu'aucune pochette n'est posee), bouton lecture cercle blanc
  40dp, precedent/suivant 32dp.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_wide">

    <ImageView
        android:id="@+id/widget_wide_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <ImageView
                android:id="@+id/widget_wide_art"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:scaleType="centerInside"
                android:src="@drawable/app_logo"
                android:contentDescription="@string/widget_artwork" />

            <LinearLayout
                android:id="@+id/widget_wide_open_app_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_wide_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_default_title"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_wide_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/widget_ready_to_play"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_wide_btn_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_btn_ripple"
                android:src="@drawable/ic_widget_skip_previous"
                android:scaleType="centerInside"
                android:padding="7dp"
                android:contentDescription="@string/widget_action_previous" />

            <ImageButton
                android:id="@+id/widget_wide_btn_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_play_btn_white"
                android:src="@drawable/ic_widget_play"
                android:scaleType="centerInside"
                android:padding="11dp"
                android:contentDescription="@string/widget_action_play" />

            <ImageButton
                android:id="@+id/widget_wide_btn_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_btn_ripple"
                android:src="@drawable/ic_widget_skip_next"
                android:scaleType="centerInside"
                android:padding="7dp"
                android:contentDescription="@string/widget_action_next" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_wide_quick_row"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="9dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <ImageButton
                android:id="@+id/widget_wide_tile_1"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_ripple"
                android:scaleType="centerCrop"
                android:padding="0dp"
                android:contentDescription="@string/widget_open_app" />

            <ImageButton
                android:id="@+id/widget_wide_tile_2"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_tile_ripple"
                android:scaleType="centerCrop"
                android:padding="0dp"
                android:contentDescription="@string/widget_open_app" />

            <ImageButton
                android:id="@+id/widget_wide_tile_3"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_tile_ripple"
                android:scaleType="centerCrop"
                android:padding="0dp"
                android:contentDescription="@string/widget_open_app" />

            <ImageButton
                android:id="@+id/widget_wide_tile_4"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_tile_ripple"
                android:scaleType="centerCrop"
                android:padding="0dp"
                android:contentDescription="@string/widget_open_app" />

            <ImageButton
                android:id="@+id/widget_wide_tile_5"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_tile_ripple"
                android:scaleType="centerCrop"
                android:padding="0dp"
                android:contentDescription="@string/widget_open_app" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
